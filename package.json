{
  "name": "nx-kn",
  "version": "0.2.0",
  "description": "Obsidian 知识库检索（zg 引擎）",
  "type": "module",
  "bin": {
    "nx-kn": "bin/kn.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/kn.mjs serve --no-open",
    "start": "pnpm run build && node bin/kn.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:pipeline": "node tests/pipeline.mjs",
    "test:all": "pnpm run test && pnpm run test:pipeline",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-kn.git"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "vite": "^6.0.7"
  }
}
